# ===== نواتج البناء =====
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# ===== 🔴 أسرار — عمرها ما تتعمل commit =====
#
# مفتاح JWT ونص الاتصال بييجوا من user-secrets محلياً، ومن متغيّرات
# البيئة على الاستضافة. اللي يقرا مفتاح JWT يقدر يعمل توكن لأي حساب.
appsettings.*.local.json
secrets.json
*.pfx
*.key

# ===== مخارج مؤقتة =====
publish/
TestResults/
*.trx

# ===== Deploy secrets - never committed =====
# Publish profiles carry the host password; generated web.config files
# carry the connection string and the JWT key.
*.PublishSettings
*.publishsettings
deploy/*.generated.config

# A web.config with real values must never land in this public repo. The
# committed ones are named api.web.config.template and dashboard.web.config.
web.config
