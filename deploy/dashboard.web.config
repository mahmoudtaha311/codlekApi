<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for the DASHBOARD on its own IIS site - static files only, no .NET.

  Layout on the site:
    /web.config          this file
    /app/index.html      the dashboard build (vite base is /app/)
    /app/assets/...

  Two rules:
  1. "/" goes to "/app/" - people type the bare address.
  2. Any /app/... path that is not a real file serves /app/index.html, so the
     dashboard's own router opens the page (a refresh on /app/reports must not 404).

  Needs the IIS URL Rewrite module (standard on MonsterASP). No secrets here.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="root-to-app" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="app/" redirectType="Found" />
        </rule>
        <rule name="dashboard-routes" stopProcessing="true">
          <match url="^app/.*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/app/index.html" />
        </rule>
      </rules>
    </rewrite>
    <!-- index.html must always be fresh: it names the hashed asset files of the current build. -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
  <location path="app/assets">
    <system.webServer>
      <staticContent>
        <!-- Hashed file names change on every build, so these can be cached for a year. -->
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
