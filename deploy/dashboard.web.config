<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for the DASHBOARD on its own IIS site - static files only, no .NET.

  Layout on the site:
    /web.config          this file
    /app/index.html      the dashboard build (vite base is /app/)
    /app/assets/...

  Three rules:
  1. http goes to https. Turn the site's SSL certificate on BEFORE uploading
     this file, or every visit is sent to an address that does not answer.
     Over plain http the page can be altered on the way (a typed password can
     be read), and the browser switches off the APIs the dashboard needs:
     navigator.locks (one token refresh across tabs) and the clipboard.
     .well-known stays reachable over http for the certificate renewal.
  2. "/" goes to "/app/" - people type the bare address.
  3. Any /app/... path that is not a real file serves /app/index.html, so the
     dashboard's own router opens the page (a refresh on /app/reports must not
     404). Except /app/assets/: a missing script must be a 404, not the page -
     after a redeploy an open tab asks for the old file names, and HTML in
     place of a script fails with a confusing module error.

  Needs the IIS URL Rewrite module (standard on MonsterASP). No secrets here.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="https-only" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <!-- 302, not 301: browsers keep a 301 for good, so a later
               certificate problem could not be undone from here. -->
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Found" />
        </rule>
        <rule name="root-to-app" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="app/" redirectType="Found" />
        </rule>
        <rule name="dashboard-routes" stopProcessing="true">
          <match url="^app/.*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{URL}" pattern="^/app/assets/" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/app/index.html" />
        </rule>
      </rules>
    </rewrite>
    <!-- index.html must always be fresh: it names the hashed asset files of the current build. -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
  <location path="app/assets">
    <system.webServer>
      <staticContent>
        <!-- Hashed file names change on every build, so these can be cached for a year. -->
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
