<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>codlek-api</UserSecretsId>

    <!--
      🔴 النشر ممنوع يولّد web.config — زي القديم بالحرف.

      الـweb.config اللي على المستضيف شايل متغيّرات البيئة: نص الاتصال
      بقاعدة الإنتاج ومفتاح JWT. والـSDK بيولّد ملف فيه معالج ASP.NET Core
      وبس — فأي نشر بيرفعه فوق اللي على السيرفر بيقطع القاعدة عن الموقع.
      الخطة نبّهت على ده من الأول ("لازم IsTransformWebConfigDisabled
      عليه زي القديم")، والسطر كان ناقص لحد مراجعة التحويل.
    -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codlek.Application\Codlek.Application.csproj" />
    <ProjectReference Include="..\Codlek.Infrastructure\Codlek.Infrastructure.csproj" />
  </ItemGroup>


</Project>
